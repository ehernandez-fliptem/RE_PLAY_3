<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SupremaAgent</RootNamespace>
    <AssemblyName>SupremaAgent</AssemblyName>
    <!--
      El SDK de Suprema (UFScanner.dll / UFMatcher.dll) es nativo y se distribuye
      por arquitectura. El agente se fija a x64 para que el P/Invoke resuelva
      contra las DLL x64. Si el SDK que descargues es x86, cambia a x86 aqui
      y vuelve a publicar; mezclar arquitecturas produce BadImageFormatException.
    -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Las DLL del SDK no estan en el repo (licencia de Suprema). El instalador
      las copia junto al ejecutable. Ver agente_biometrico/sdk/LEEME.md.
    -->
    <None Include="..\..\sdk\*.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\sdk')" />
  </ItemGroup>

</Project>
